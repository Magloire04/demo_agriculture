# Identifiants de l'API de reconnaissance vocale JaimeMaLangue (transmis séparément).
# Ils restent sur le serveur : ne jamais les mettre dans le code de l'application ni les committer.
ASR_ID=
ASR_MDP=

# Adresse de l'API (valeur par défaut)
# ASR_URL=https://51-159-167-70.sslip.io

# 1 = réponses factices, sans appel à l'API (pour essayer l'interface)
# ASR_SIMULATION=1

PORT=3000
# HOST=0.0.0.0

# Dossier où sont gardés les signalements et leurs audios
# DOSSIER_DONNEES=stockage

# Si renseigné, l'espace conseiller (/conseiller) demande ce code
# CODE_CONSEILLER=

# Génération des extraits audio (scripts/voix/generer.js), sur un poste seulement :
# adresse et clé de l'API de synthèse fon FongLab. Inutiles sur le serveur.
# La relecture des extraits (scripts/voix/evaluer.js) utilise ASR_ID et ASR_MDP.
# FONGLAB_TTS_URL=https://tts.princespecial.me
# FONGLAB_TTS_API_KEY=

# Voix des réponses en phrases entières : route de synthèse de l'application JML,
# appelée avec ASR_ID et ASR_MDP. Valeurs par défaut :
# VOIX_URL=https://51-159-167-70.sslip.io/app/api/tts-fon-p1
# VOIX_NOM=homme2
# 0 coupe cette voix (anciens extraits seulement) :
# VOIX_PHRASES=0

# Les solutions proposées après un signalement ne sont montrées qu'une fois leur fon
# relu par un locuteur (data/solutions.json, "fon_a_relire": false). Pour une
# démonstration avant cette relecture, mettre 1.
# SOLUTIONS_BROUILLON=1
# (valeur de départ seulement : ensuite, le réglage du back office l'emporte)

# Mot de passe du back office (/admin) : seule son empreinte est gardée ici.
# À écrire sur le serveur par : node scripts/admin-mot-de-passe.js
# ADMIN_MDP_EMPREINTE=
